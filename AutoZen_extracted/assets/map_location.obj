# Simple textured plane for HERE SDK
# Car image mapped onto flat surface - square aspect ratio

# Vertices - flat square with very thin depth
v -1.0  1.0  0.0
v  1.0  1.0  0.0
v  1.0 -1.0  0.0
v -1.0 -1.0  0.0
v -1.0  1.0  0.0
v  1.0  1.0  0.0
v  1.0 -1.0  0.0
v -1.0 -1.0  0.0

# Texture coordinates (maps entire PNG to the plane)
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

# Normals
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0

# Top face (visible from above - shows texture)
f 1/1/1 2/2/1 3/3/1 4/4/1

# Bottom face
f 8/4/2 7/3/2 6/2/2 5/1/2

# Front face
f 1/1/3 5/4/3 6/3/3 2/2/3

# Back face
f 3/1/4 7/4/4 8/3/4 4/2/4

# Left face
f 4/1/5 8/4/5 5/3/5 1/2/5

# Right face
f 2/1/6 6/4/6 7/3/6 3/2/6
